{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Stretch Water Windows PRUEBA",
  "version": "0.1.0",
  "identifier": "com.stretchandwater.windows.poc",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'self'; style-src 'self'; img-src 'self'; object-src 'none'; base-uri 'none'"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
